# CRM login (set real values only in Render Environment Variables)
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
CRM_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Google Places / client capture
# Enable Places API (New) and billing in Google Cloud before setting this value.
GOOGLE_MAPS_API_KEY=

# OpenAI (optional for V1; deterministic SDR remains fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_ASSIST_ENABLED=false

# Meta official API (when enabled)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v20.0

# Runtime
NODE_ENV=production
