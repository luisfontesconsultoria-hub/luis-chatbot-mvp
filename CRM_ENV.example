# CRM login (set real values only in Render Environment Variables)
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# OpenAI (optional for V1; SDR remains fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Meta official API (when enabled)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Runtime
NODE_ENV=production
